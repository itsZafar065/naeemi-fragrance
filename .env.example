# Required server-side secrets
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/naeemi-fragrance"
JWT_SECRET="replace-with-a-long-random-secret"

# Public browser-safe values
NEXT_PUBLIC_APP_URL="https://your-domain.example"
NEXT_PUBLIC_PUSHER_KEY="your-public-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"

# Server-side Pusher credentials
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"

# SMTP email delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="smtp-user@example.com"
SMTP_PASS="smtp-password"
SMTP_FROM="\"Naeemi Fragrance\" <no-reply@example.com>"
BUSINESS_EMAIL="support@example.com"

# Seed-only admin bootstrap credentials
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-strong-owner-password"
SEED_OWNER_NAME="Store Owner"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-strong-admin-password"
SEED_ADMIN_NAME="Store Admin"
SEED_MANAGER_EMAIL="manager@example.com"
SEED_MANAGER_PASSWORD="replace-with-strong-manager-password"
SEED_MANAGER_NAME="Store Manager"
